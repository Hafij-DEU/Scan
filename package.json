{
  "name": "docscan",
  "version": "0.2.0",
  "description": "Document scanner: capture, auto-crop, enhance and export to PDF",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "author": {
    "name": "Hafij-BGE",
    "email": "mdhafijur.rahman@ogr.deu.edu.tr"
  },
  "homepage": "https://github.com/Hafij-DEU/Scan",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "start": "tauri dev",
    "build:deb": "tauri build --bundles deb && node scripts/collect-release.mjs",
    "build:win": "tauri build --bundles nsis && node scripts/collect-release.mjs",
    "sync:android": "node scripts/sync-android.mjs",
    "build:apk": "pnpm run build:web && pnpm run sync:android && cd android && ~/.local/opt/gradle-8.11.1/bin/gradle --offline assembleDebug"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
