{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocScan",
  "mainBinaryName": "docscan",
  "version": "../package.json",
  "identifier": "io.github.hafijbge.docscan",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/copy-ocr.mjs && pnpm exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Scan documents with your camera and export PDF",
    "longDescription": "Offline document scanner: capture or import photos, auto-crop, perspective correction, filters and PDF export. No account, no ads, no tracking.",
    "publisher": "Hafij-BGE",
    "copyright": "MIT © 2026 Hafij-BGE",
    "license": "MIT",
    "homepage": "https://github.com/Hafij-DEU/Scan",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
